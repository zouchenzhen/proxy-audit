# Copy this file to .1password/proxy-audit.env and replace each placeholder
# with the matching 1Password secret reference. This file contains references
# only; never put plaintext API keys here.
# For additional keys, repeat the variable with a consecutive _2, _3, ...
# suffix. Scamalytics usernames and keys must use matching numeric suffixes.
PROXY_AUDIT_IPAPI_IS_API_KEY_1="op://<vault>/<ipapi-is-item>/credential"
PROXY_AUDIT_IPINFO_API_KEY_1="op://<vault>/<ipinfo-item>/credential"
# PROXY_AUDIT_IPINFO_API_KEY_2="op://<vault>/<second-ipinfo-item>/credential"
PROXY_AUDIT_IP2LOCATION_API_KEY_1="op://<vault>/<ip2location-item>/credential"
# PROXY_AUDIT_IP2LOCATION_API_KEY_2="op://<vault>/<second-ip2location-item>/credential"
PROXY_AUDIT_IPQS_API_KEY_1="op://<vault>/<ipqs-item>/credential"
# PROXY_AUDIT_IPQS_API_KEY_2="op://<vault>/<second-ipqs-item>/credential"
PROXY_AUDIT_SCAMALYTICS_USER_1="op://<vault>/<scamalytics-item>/username"
PROXY_AUDIT_SCAMALYTICS_API_KEY_1="op://<vault>/<scamalytics-item>/credential"
PROXY_AUDIT_ABUSEIPDB_API_KEY_1="op://<vault>/<abuseipdb-item>/credential"
# PROXY_AUDIT_ABUSEIPDB_API_KEY_2="op://<vault>/<second-abuseipdb-item>/credential"
