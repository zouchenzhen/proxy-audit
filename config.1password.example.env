# Copy this file to .1password/proxy-audit.env and replace each placeholder
# with the matching 1Password secret reference. This file contains references
# only; never put plaintext API keys here.
PROXY_AUDIT_IPINFO_API_KEY_1="op://<vault>/<ipinfo-item>/credential"
PROXY_AUDIT_IP2LOCATION_API_KEY_1="op://<vault>/<ip2location-item>/credential"
PROXY_AUDIT_IPQS_API_KEY_1="op://<vault>/<ipqs-item>/credential"
PROXY_AUDIT_SCAMALYTICS_USER="op://<vault>/<scamalytics-item>/username"
PROXY_AUDIT_SCAMALYTICS_API_KEY_1="op://<vault>/<scamalytics-item>/credential"
PROXY_AUDIT_ABUSEIPDB_API_KEY_1="op://<vault>/<abuseipdb-item>/credential"
